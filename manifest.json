{
  "manifest_version": 3,
  "name": "GitHub Native Markdown Enhance",
  "description": "Insert Markdown into GitHub's native Issue and file editors.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
